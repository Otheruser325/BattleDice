{
  "name": "battle-dice-autoroller",
  "private": true,
  "version": "0.7.6-beta",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:launcher": "npm run launcher:prepare:dev && vite --host 127.0.0.1",
    "build": "node scripts/build-with-playtest-cleanup.mjs",
    "preview": "vite preview",
    "launcher:prepare": "npm run bundle:playtest && npm run copy:playtest-assets",
    "launcher:prepare:dev": "npm run bundle:playtest:dev && npm run copy:playtest-assets",
    "launcher:clean": "node scripts/clean-playtest-assets.mjs",
    "bundle:playtest": "node scripts/build-playtest-bundle.mjs",
    "bundle:playtest:dev": "node scripts/build-playtest-bundle.mjs --dev",
    "copy:playtest-assets": "node scripts/sync-playtest-assets.mjs",
    "clean:playtest-assets": "npm run launcher:clean",
    "dev:clean": "npm run launcher:clean",
    "preview:launcher": "npm run launcher:prepare && vite --host 127.0.0.1"
  },
  "dependencies": {
    "@rivalis/browser": "^6.0.0",
    "@toolcase/base": "^2.0.0",
    "@toolcase/logging": "^2.0.0",
    "@toolcase/serializer": "^2.0.2",
    "phaser": "^3.90.0",
    "process": "^0.11.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vite-plugin-node-polyfills": "^0.28.0",
    "webpack": "^5.x",
    "webpack-cli": "^5.x"
  },
  "overrides": {
    "protobufjs": "^8.8.1",
    "nanoid": "^3.3.20",
    "qs": "^6.16.1",
    "fast-uri": "^3.1.7",
    "browserslist": "^4.28.7",
    "source-map-js": "^1.2.2",
    "postcss": "^8.5.23"
  }
}
