# Copy to .env.local for local overrides. See the README "Environment flags" table.
# Boolean values accept 1/true/yes/on and 0/false/no/off.

# Dev tooling (refused by production builds; on by default in `npm run dev`/`dev:launcher`)
# VITE_ENABLE_DEV_MENU=1
# VITE_DEBUG_LOGS=1

# Rivalis multiplayer
# VITE_RIVALIS_WS_URL=wss://example.com/rivalis
# VITE_RIVALIS_TICKET_ENDPOINT=/api/rivalis-ticket
# VITE_RIVALIS_RECONNECT_MAX=4

# Base path (build config). REPO_FIX takes precedence over VITE_BASE_PATH.
# VITE_BASE_PATH=/BattleDice/

# Launcher bundle options
# BATTLE_DICE_BUILD_MODE=development
# BATTLE_DICE_SOURCEMAP=1
