NODE_ENV=development
HOST=0.0.0.0
PORT=8080

# The browser origin(s) allowed to fetch tickets and open the WebSocket.
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Required in production. Use at least 32 random bytes.
TICKET_SECRET=replace-with-a-32-byte-random-secret
TICKET_TTL_SECONDS=7200
TICKET_REQUESTS_PER_MINUTE=30
# Guest identity cookie lifetime and per-IP rename/creation limit.
GUEST_IDENTITY_TTL_SECONDS=2592000
IDENTITY_REQUESTS_PER_MINUTE=20

# Set to 1 only when running behind a trusted proxy that supplies X-Forwarded-For.
TRUST_PROXY=0

MAX_ACTORS=512
MAX_QUEUE=200
MAX_LOBBIES=100
MAX_MATCHES=100

QUEUE_TTL_SECONDS=300
LOBBY_TTL_SECONDS=900
MATCH_TTL_SECONDS=1800

ACTION_LIMIT=12
ACTION_WINDOW_SECONDS=60
