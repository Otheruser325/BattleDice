    "@toolcase/serializer": "^2.0.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  }
}
