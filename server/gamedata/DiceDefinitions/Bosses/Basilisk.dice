{
  "typeId": "Basilisk",
  "title": "Basilisk Dice",
  "attack": 40,
  "health": 2500,
  "range": 4,
  "footprint": 2,
  "rarity": "Mythic",
  "skills": [
    {
      "type": "Passive",
      "title": "Distorting Appearance",
      "description": "Enemy dice in Basilisk's range have a 30% chance to ignore attacking the boss outright until the next turn.",
      "modifiers": {
        "avoidAttackChance": 0.3
      }
    },
    {
      "type": "OnKill",
      "title": "Delicious Appetite",
      "description": "Dice defeated by Basilisk restore 25% of Basilisk's missing max HP.",
      "modifiers": {
        "missingHealRate": 0.25
      }
    },
    {
      "type": "Passive",
      "title": "Rapacious Revenge",
      "description": "When Basilisk falls below 20% HP, it bites the nearest enemy dice 5 times for 100 damage.",
      "modifiers": {
        "hasRevenge": true,
        "revengeThresholdRate": 0.2,
        "revengeHits": 5,
        "revengeDamage": 100,
        "unlockAtClass": 6
      }
    }
  ],
  "accent": "#6abf69",
  "targetingMode": "Weakest",
  "isBoss": true
}
