{
  "typeId": "Druid",
  "title": "Druid Dice",
  "attack": 36,
  "health": 600,
  "range": 5,
  "rarity": "Legendary",
  "skills": [
    {
      "type": "Passive",
      "title": "Druidic Essence",
      "description": "Instead of attacking enemies, basic attacks heal the weakest ally for the full attack power, and orbs ricochet onto 1 nearby ally within 2 tiles.",
      "modifiers": {
        "ricochetHealCount": 1,
        "ricochetHealRange": 2,
        "skillTargeting": "Weakest",
        "notes": [
          "runtime:druidicEssence"
        ],
        "skillSfx": "dice_heal_skill",
        "onlyTargetsAllies": true
      }
    },
    {
      "type": "Active",
      "title": "Ferocious Nature",
      "description": "Transforms into a powerful bear after helping his allies for long enough.",
      "manaNeeded": 20,
      "modifiers": {
        "consumeAttack": false,
        "transformSkillIndices": [
          2,
          3
        ],
        "transformTitle": "Druid Bear",
        "alternateButton": "View Druid Bear",
        "baseButton": "View Druid Dice",
        "notes": [
          "runtime:druidBearTransform"
        ],
        "skillSfx": "dice_berserk_skill"
      }
    },
    {
      "type": "OnTransformed",
      "title": "Uncontrollable Maul",
      "description": "Teleports onto the nearest enemy and deals 250 damage upon mauling.",
      "modifiers": {
        "bearMaulDamage": 250,
        "notes": [
          "runtime:druidBearForm"
        ]
      }
    },
    {
      "type": "Passive",
      "title": "Critical Claw",
      "description": "Basic attacks have a 20% chance of dealing 100% more damage.",
      "modifiers": {
        "bearCritChance": 0.2,
        "bearCritMultiplier": 2,
        "notes": [
          "runtime:druidBearForm"
        ]
      }
    }
  ],
  "transformDescriptions": [
    "Bear Form: 1500 HP, 50 damage, range 2. Teleports onto the nearest enemy and mauls for 250 damage, then basic attacks can critically strike."
  ],
  "accent": "#6ec97a",
  "targetingMode": "Nearest"
}
